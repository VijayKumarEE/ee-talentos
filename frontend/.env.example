# Copy to .env.local for local overrides (git-ignored), or set as a
# build-time env var / GitHub Actions variable for the cloud build.
#
# This is PUBLIC configuration only - never put secrets in a
# VITE_-prefixed variable, since Vite bundles them straight into the
# JavaScript shipped to every browser.

# LOCAL MODE default (used automatically if this is unset): http://127.0.0.1:8000
# CLOUD MODE: your deployed Render backend URL, e.g. https://ee-talentos-backend.onrender.com
VITE_API_BASE_URL=
