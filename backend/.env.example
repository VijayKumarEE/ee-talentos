# Copy this file to backend/.env and fill in real values there.
# backend/.env is git-ignored (see backend/.gitignore) - never commit it.

# ---------------------------------------------------------------------
# APP_MODE - the one switch that decides everything else below.
#   local -> SQLite + Ollama + faster-whisper + local filesystem
#            (default; everything below except the GITHUB_* section
#            can be left blank in this mode)
#   cloud -> Supabase Postgres + OpenRouter + Supabase Storage
APP_MODE=local

# ---------------------------------------------------------------------
# GitHub showcase (both modes - this is unchanged from the original
# local app). If left blank, the showcase push is silently skipped;
# nothing else breaks.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_DATA_PATH=data/candidates.json

# ---------------------------------------------------------------------
# CLOUD MODE ONLY - Supabase database
# Project Settings -> Database -> Connection string ("Transaction"
# pooler mode is recommended for a free-tier host like Render).
SUPABASE_DB_URL=

# ---------------------------------------------------------------------
# CLOUD MODE ONLY - Supabase project (for Storage)
# Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: full access. Backend-only. NEVER put this in the
# frontend/.env or any VITE_-prefixed variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes
SUPABASE_RECORDING_BUCKET=recordings
SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# ---------------------------------------------------------------------
# CLOUD MODE ONLY - OpenRouter (AI scoring + transcription).
# Backend-only. NEVER put this in the frontend or any VITE_-prefixed
# variable, and never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_ASSESSMENT_MODEL=google/gemini-2.5-flash
OPENROUTER_TRANSCRIPTION_MODEL=google/gemini-2.5-flash

# ---------------------------------------------------------------------
# CLOUD MODE ONLY - cost controls
AI_MONTHLY_BUDGET_USD=20
AI_MAX_ASSESSMENT_CALLS_PER_MONTH=500

# ---------------------------------------------------------------------
# CLOUD MODE ONLY - CORS
# Comma-separated list of allowed browser origins, e.g. your GitHub
# Pages URL. LOCAL MODE ignores this and always allows the local Vite
# dev server origins instead.
CORS_ORIGINS=https://yourname.github.io
